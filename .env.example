# Copy to .env on the Hetzner host, chmod 600, and replace every placeholder.
# This file is intentionally safe to commit. Never put real secrets here.

APP_DOMAIN=homing.hartphoenix.com
PUBLIC_BASE_URL=https://homing.hartphoenix.com
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=homing.hartphoenix.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://homing.hartphoenix.com
ALLOW_PUBLIC_SIGNUP=false
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Transactional mail. Leave EMAIL_HOST empty for a local console backend.
# For production, use any SMTP provider (for example Resend):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=replace-with-smtp-api-key
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Homing <notifications@homing.hartphoenix.com>
# Password-reset links expire after 15 minutes.
PASSWORD_RESET_TIMEOUT=900
# EMAIL_FILE_PATH=/tmp/homing-mailbox

POSTGRES_DB=homing
POSTGRES_USER=homing
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://homing:replace-with-a-long-random-database-password@db:5432/homing

# Gunicorn and request limits. Keep the worker count conservative on a small VPS.
GUNICORN_APP_MODULE=config.wsgi:application
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Caches/rate limiting may use the database in the first deployment.
REDIS_URL=

# Backups use age encryption and an off-host rclone destination.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_RCLONE_REMOTE=remote:homing/backups
BACKUP_RETENTION_DAYS=35
# Optional host-only restore setting; alternatively export it for each restore.
# AGE_IDENTITY_FILE=/secure/off-host/homing.agekey
