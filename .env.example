# Copy to .env on the Hetzner host, chmod 600, and replace every placeholder.
# This file is intentionally safe to commit. Never put real secrets here.

APP_DOMAIN=sublets.example.com
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=sublets.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sublets.example.com
ALLOW_PUBLIC_SIGNUP=false
SECURE_SSL_REDIRECT=true

POSTGRES_DB=sublet_tracker
POSTGRES_USER=sublet_tracker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://sublet_tracker:replace-with-a-long-random-database-password@db:5432/sublet_tracker

# Gunicorn and request limits. Keep the worker count conservative on a small VPS.
GUNICORN_APP_MODULE=config.wsgi:application
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Caches/rate limiting may use the database in the first deployment.
REDIS_URL=

# Backups use age encryption and an off-host rclone destination.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_RCLONE_REMOTE=remote:sublet-tracker/backups
BACKUP_RETENTION_DAYS=35
