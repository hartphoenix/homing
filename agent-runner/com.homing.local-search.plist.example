<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.homing.local-search</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; . "$HOME/.config/homing/runner.env"; set +a; exec /Users/rhhart/Documents/GitHub/homing/agent-runner/run-claude-search.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>WorkingDirectory</key><string>/Users/rhhart/Documents/GitHub/homing</string>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/rhhart/Library/Logs/Homing/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/rhhart/Library/Logs/Homing/launchd.err.log</string>
</dict>
</plist>
